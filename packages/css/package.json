{
  "name": "@marmotdata/css",
  "version": "0.1.0",
  "description": "Zero-JS mm-* classes for static and server-rendered Marmot pages (docs and marketing). Same visuals as @marmotdata/elements.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/marmotdata/design-system.git", "directory": "packages/css" },
  "files": ["dist"],
  "sideEffects": ["*.css"],
  "exports": { ".": "./dist/marmot.css", "./*.css": "./dist/*.css" },
  "scripts": { "build": "node scripts/build.ts" },
  "dependencies": { "@marmotdata/tokens": "workspace:^" },
  "publishConfig": { "access": "public", "provenance": true }
}
