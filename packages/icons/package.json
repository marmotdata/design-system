{
  "name": "@marmotdata/icons",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmotdata/design-system.git",
    "directory": "packages/icons"
  },
  "files": [
    "dist",
    "custom-elements.json",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "./dist/define.js",
    "./dist/ui.js",
    "./dist/providers-all.js",
    "./src/define.ts",
    "./src/ui.ts",
    "./src/providers-all.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@iconify-json/devicon": "^1.2.72",
    "@iconify-json/logos": "1.2.18",
    "@iconify-json/material-symbols": "1.2.96",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify/utils": "3.1.7",
    "simple-icons": "^16.36.0"
  },
  "dependencies": {
    "lit": "3.3.3",
    "tslib": "^2.8.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define.js": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./ui.js": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./providers-all.js": {
      "types": "./dist/providers-all.d.ts",
      "default": "./dist/providers-all.js"
    },
    "./icon.js": {
      "types": "./dist/icon.d.ts",
      "default": "./dist/icon.js"
    },
    "./provider-logo.js": {
      "types": "./dist/provider-logo.d.ts",
      "default": "./dist/provider-logo.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "main": "./dist/index.js"
}