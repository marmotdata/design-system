{
  "name": "@marmotdata/elements",
  "version": "0.1.1",
  "description": "The Marmot component library as standards-based web components (Lit). Every tag is prefixed mm-.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmotdata/design-system.git",
    "directory": "packages/elements"
  },
  "files": [
    "dist",
    "custom-elements.json",
    "strings.json"
  ],
  "customElements": "custom-elements.json",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*"
    },
    "./classes/*.js": {
      "types": "./dist/components/*/class.d.ts",
      "default": "./dist/components/*/class.js"
    },
    "./classes/*": {
      "types": "./dist/components/*/class.d.ts",
      "default": "./dist/components/*/class.js"
    },
    "./codemirror-theme.js": {
      "types": "./dist/components/code-editor/theme.d.ts",
      "default": "./dist/components/code-editor/theme.js"
    },
    "./*.js": {
      "types": "./dist/components/*/define.d.ts",
      "default": "./dist/components/*/define.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./strings.json": "./strings.json"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*/define.js",
    "./src/index.ts",
    "./src/components/*/define.ts"
  ],
  "scripts": {
    "build": "node scripts/gen-index.mjs && node scripts/build-dagre-source.mjs && node scripts/gen-strings.mjs && tsc -p tsconfig.build.json && pnpm run cem",
    "dev": "tsc -p tsconfig.build.json --watch",
    "cem": "cem analyze",
    "strings": "node scripts/gen-strings.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "3.1.3",
    "@floating-ui/dom": "1.8.0",
    "@lezer/highlight": "^1.2.5",
    "@lit-labs/virtualizer": "2.1.1",
    "@marmotdata/icons": "workspace:*",
    "@marmotdata/tokens": "workspace:*",
    "@tanstack/virtual-core": "3.19.8",
    "codemirror": "6.0.2",
    "d3-array": "3.2.4",
    "d3-contour": "4.0.2",
    "d3-scale": "4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "3.2.0",
    "d3-zoom": "3.0.0",
    "lit": "3.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-zoom": "^3.0.9",
    "esbuild": "0.28.2"
  }
}
