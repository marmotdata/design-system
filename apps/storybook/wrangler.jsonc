// Storybook as a static Worker, like the team docs. .github/workflows/storybook.yml deploys it on
// every push to main; its custom domain (storybook.marmot.team) and the Access application in
// front of it are managed in the infra repo's Cloudflare Terraform.
{
  "name": "marmot-team-storybook",
  "account_id": "9fa8a02bb52c8d6a49834c5255ab7049",
  "compatibility_date": "2025-04-04",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./storybook-static"
  }
}
